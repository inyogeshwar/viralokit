# ===================================================
# PostGram — Zero-Cost Production Environment Variables
# ===================================================

# Public App Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------
# WorkOS AuthKit (Free Tier — https://workos.com)
# ---------------------------------------------------
WORKOS_API_KEY=sk_test_example_key
WORKOS_CLIENT_ID=client_example_id
WORKOS_COOKIE_PASSWORD=a_long_random_string_at_least_32_characters_long
# WorkOS Redirect URI configured in WorkOS dashboard: http://localhost:3000/callback
# Optional single-tenant authorization allowlist (comma-separated WorkOS user IDs)
ADMIN_WORKOS_USER_IDS=user_01H...example

# ---------------------------------------------------
# Neon PostgreSQL (Free Tier — https://neon.tech)
# ---------------------------------------------------
DATABASE_URL=postgresql://user:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------------------------------------------------
# Meta Graph API (Official Instagram Platform)
# ---------------------------------------------------
# Default Meta Graph API version verified from Meta Developer Docs
META_GRAPH_API_VERSION=v23.0
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Default connected account credentials (server-side only)
IG_USER_ID=your_instagram_user_id
IG_ACCESS_TOKEN=your_instagram_access_token

# ---------------------------------------------------
# Cloudinary (Free Plan — https://cloudinary.com)
# ---------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ---------------------------------------------------
# AI Services (Zero Cost)
# ---------------------------------------------------
# OpenRouter API Key for dynamic free models (https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key

# Google Gemini API Key for multimodal fallback (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key
